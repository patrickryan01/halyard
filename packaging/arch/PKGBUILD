# Maintainer: Fireball Industries <patrick@fireballz.ai>
# Builds from the source tarball that packaging/make-source.sh writes next to this file.
pkgname=halyard
pkgver=${HALYARD_VERSION:-1.0.0}
pkgrel=1
pkgdesc='Halyard: a modular mail client for Google, Microsoft 365 and self-hosted mail, with a built in MCP server'
arch=(x86_64)
url='https://github.com/patrickryan01/halyard'
license=(custom:Proprietary)
depends=(gtk3 webkit2gtk-4.1 libsecret xdg-utils)
makedepends=(go gcc pkgconf)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=(SKIP)
options=(!debug)

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=1 GOFLAGS=-mod=readonly
  LDF=$(HALYARD_VERSION=$pkgver sh packaging/common/build-flags.sh)
  go build -trimpath -tags "desktop,production,webkit2_41" -ldflags "$LDF" -o "$srcdir/halyard" ./cmd/halyard
  CGO_ENABLED=0 go build -trimpath -ldflags "$LDF" -o "$srcdir/halyardd" ./cmd/halyardd
  CGO_ENABLED=0 go build -trimpath -ldflags "$LDF" -o "$srcdir/halyardctl" ./cmd/halyardctl
}

check() {
  cd "$pkgname-$pkgver"
  go test ./internal/store ./internal/mime ./internal/discover ./internal/ical ./internal/rules ./internal/secure ./internal/sieve ./internal/dav ./internal/cli
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$srcdir/halyard" "$pkgdir/usr/bin/halyard"
  install -Dm755 "$srcdir/halyardd" "$pkgdir/usr/bin/halyardd"
  install -Dm755 "$srcdir/halyardctl" "$pkgdir/usr/bin/halyardctl"
  install -Dm644 packaging/common/halyard.desktop "$pkgdir/usr/share/applications/halyard.desktop"
  install -Dm644 packaging/common/halyard.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/halyard.svg"
  install -Dm644 packaging/common/halyard-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/halyard.png"
  install -Dm644 packaging/common/halyard-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/halyard.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
